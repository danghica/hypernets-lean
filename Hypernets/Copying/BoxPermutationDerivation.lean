import Hypernets.Copying.AbstractionShell

/-! Explicit syntactic derivations generated by BPerm and graph congruence.
This relation is syntactic; its contextual exact-cost interpretation is proved
separately in ContextualDerivation using the full BPerm robustness theorem. -/
set_option backward.isDefEq.respectTransparency false
namespace Hypernets.Copying.BoxPermutation
open Graph

/-- Finite proof trees using only the concrete box rule, recursive isomorphism,
and the displayed structural operations. Padding is representation congruence. -/
inductive Derivation : {d : Nat} → {I O : List Wire} → Hypernet d I O → Hypernet d I O → Prop where
  | iso {d I O} {G H : Hypernet d I O} (f : DeepIso G H) : Derivation G H
  | rule {d I O} {G H : Hypernet d I O} (s : Step G H) : Derivation G H
  | symm {d I O} {G H : Hypernet d I O} : Derivation G H → Derivation H G
  | trans {d I O} {G H K : Hypernet d I O} : Derivation G H → Derivation H K → Derivation G K
  | serial {d I J O} {G G' : Hypernet d I J} {H H' : Hypernet d J O} :
      Derivation G G' → Derivation H H' → Derivation (Serial.net G H) (Serial.net G' H')
  | tensor {d I O J K} {G G' : Hypernet d I O} {H H' : Hypernet d J K} :
      Derivation G G' → Derivation H H' → Derivation (Net.Tensor.net G H) (Net.Tensor.net G' H')
  | parallel {d : Nat} {A : Type} {I O : A → List Wire} {J K : List Wire}
      {G H : ∀ a, Hypernet d (I a) (O a)} (B : Net.Parallel.Boundary I O J K) (finite : Enumeration A) :
      (∀ a, Derivation (G a) (H a)) → Derivation (Net.Parallel.net G B finite) (Net.Parallel.net H B finite)
  | box {d n k h} {G H : Hypernet d [.term] (environmentInterface (n+k) h)} :
      Derivation G H → Derivation (Copying.box (bound := n) (freeVariables := k) G) (Copying.box (bound := n) (freeVariables := k) H)
  | interfaces {d I O J K} {G H : Hypernet d I O} (hi : I = J) (ho : O = K) :
      Derivation G H → Derivation (Translation.castInterfaces hi ho G) (Translation.castInterfaces hi ho H)
  | raise {d I O} {G H : Hypernet d I O} : Derivation G H → Derivation (Copying.raise d G) (Copying.raise d H)

namespace Derivation

theorem refl {d I O} (G : Hypernet d I O) : Derivation G G := .iso (DeepIso.refl G)

theorem of_upToIso {d I O} {G H : Hypernet d I O} (s : UpToIso G H) : Derivation G H := by
  cases s with
  | witness f s g => exact (Derivation.iso f).trans ((Derivation.rule s).trans (Derivation.iso g))

theorem depthCast {d e I O} {G H : Hypernet d I O} (eq : d = e) (s : Derivation G H) :
    Derivation (Translation.castDepth eq G) (Translation.castDepth eq H) := by cases eq; exact s

theorem pad {d I O} {G H : Hypernet d I O} (s : Derivation G H) (n : Nat) :
    Derivation (Translation.pad d n G) (Translation.pad d n H) := by
  induction n with
  | zero => exact s
  | succ n ih => exact ih.raise

theorem padTo {d I O} {G H : Hypernet d I O} (s : Derivation G H) (n : Nat) (bound : d ≤ n) :
    Derivation (Translation.padTo n bound G) (Translation.padTo n bound H) :=
  (s.pad (n-d)).depthCast _

theorem shell {d k h} {G H : Hypernet d [.thunk 1] (environmentInterface k h)} (s : Derivation G H) :
    Derivation (AbstractionShell.graph G) (AbstractionShell.graph H) :=
  ((refl _).serial s).serial (refl _)

theorem abstraction {d k h} {G H : Hypernet d [.term] (environmentInterface (k+1) h)} (s : Derivation G H) :
    Derivation (Translation.abstraction G) (Translation.abstraction H) :=
  ((s.interfaces rfl _).box).shell

theorem unary {d k h} {G H : Hypernet d [.term] (environmentInterface k h)} (s : Derivation G H) (o : Unary) :
    Derivation (Translation.unary o G) (Translation.unary o H) :=
  ((refl _).serial s).serial (refl _)
theorem pair {d k h} {G G' H H' : Hypernet d [.term] (environmentInterface k h)}
    (s : Derivation G G') (t : Derivation H H') :
    Derivation (Translation.pair G H) (Translation.pair G' H') := by
  apply Derivation.interfaces
  apply Derivation.parallel
  intro b
  cases b
  · exact s
  · exact t

theorem application {d k h} {G G' H H' : Hypernet d [.term] (environmentInterface k h)}
    (s : Derivation G G') (t : Derivation H H') :
    Derivation (Translation.application G H) (Translation.application G' H') :=
  ((refl _).serial (s.pair t)).serial (refl _)

theorem binary {d k h} {G G' H H' : Hypernet d [.term] (environmentInterface k h)}
    (s : Derivation G G') (t : Derivation H H') (o : Binary) :
    Derivation (Translation.binary o G H) (Translation.binary o G' H') :=
  ((refl _).serial (s.pair t)).serial (refl _)
end Derivation
end Hypernets.Copying.BoxPermutation
