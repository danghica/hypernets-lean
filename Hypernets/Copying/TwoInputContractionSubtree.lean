import Hypernets.Copying.SelectedContractionSubtree

/-! Selecting both equality operands retains exactly their forward sharing
 ancestries; arbitrary unrelated branches become ordinary side inputs. -/
set_option backward.isDefEq.respectTransparency false
namespace Hypernets.Copying.ContractionTree
open Graph Opening

private theorem distinct_members {α : Type} (xs : List α) :
    ∃ ys : List α, ys.Nodup ∧ ∀ a, a ∈ ys ↔ a ∈ xs := by
  classical
  induction xs with
  | nil => exact ⟨[],by simp,by simp⟩
  | cons a xs ih =>
    obtain ⟨ys,nd,same⟩ := ih
    by_cases member : a ∈ ys
    · refine ⟨ys,nd,?_⟩
      intro b
      constructor
      · intro h; exact List.mem_cons_of_mem _ ((same _).mp h)
      · intro h
        rcases List.mem_cons.mp h with eq | h
        · exact eq ▸ member
        · exact (same _).mpr h
    · exact ⟨a::ys,by simp [member,nd],by intro b; simp only [List.mem_cons,same]⟩

namespace Selection
variable {s : ShareSort} {m : Nat} {T : ContractionTree s m} (S : Selection T)

/-- An actual finite boundary order starts with any two prescribed distinct inputs. -/
theorem two_input_order (a b : S.Vertex) (ab : a ≠ b)
    (ha : S.Input a) (hb : S.Input b) :
    ∃ rest : List S.Vertex, (a::b::rest).Nodup ∧
      ∀ v, v ∈ a::b::rest ↔ S.Input v := by
  classical
  let en := (T.net.toSet.finiteVertex.subtype S.Incident).subtype S.Input
  obtain ⟨xs,nd,same⟩ := distinct_members (en.elements.map Subtype.val)
  have members (v : S.Vertex) : v ∈ xs ↔ S.Input v := by
    rw [same]
    constructor
    · intro h; obtain ⟨x,_,eq⟩ := List.mem_map.mp h; exact eq ▸ x.property
    · intro h; exact List.mem_map.mpr ⟨⟨v,h⟩,en.complete _,rfl⟩
  let rest := xs.filter (fun v => decide (v ≠ a ∧ v ≠ b))
  have memrest (v : S.Vertex) : v ∈ rest ↔ S.Input v ∧ v ≠ a ∧ v ≠ b := by
    simp only [rest,List.mem_filter,decide_eq_true_eq,members]
  have restnd : rest.Nodup := List.Pairwise.filter _ nd
  refine ⟨rest,?_,?_⟩
  · simp only [List.nodup_cons]
    exact ⟨by simp [memrest,ab],by simp [memrest],restnd⟩
  · intro v
    simp only [List.mem_cons,memrest]
    constructor
    · rintro (rfl | rfl | h)
      · exact ha
      · exact hb
      · exact h.1
    · intro h
      by_cases va : v = a
      · exact Or.inl va
      · by_cases vb : v = b
        · exact Or.inr (Or.inl vb)
        · exact Or.inr (Or.inr ⟨h,va,vb⟩)
end Selection

variable {s : ShareSort} {m : Nat} (T : ContractionTree s m)

/-- Edge selection generated by one original exposed input. -/
def FromInput (i : Fin (List.replicate m s.wire).length) (e : T.net.Edge) : Prop :=
  ∃ a n, Port.input i ∈ T.net.source a ∧ Trace T.net.Adjacent a e n

private theorem trace_last {α : Type} {R : α → α → Prop} {a b c n}
    (path : Trace R a b n) (hop : R b c) : Trace R a c (n+1) := by
  induction path with
  | refl a => exact .step hop (.refl _)
  | step h p ih => exact .step h (ih hop)

/-- The union of the two selected input ancestries is forward closed and contains the root. -/
def twoSelection (i j : Fin (List.replicate m s.wire).length) : Selection T where
  chosen e := T.FromInput i e ∨ T.FromInput j e
  forward := by
    intro e f h adj
    rcases h with ⟨a,n,source,path⟩ | ⟨a,n,source,path⟩
    · exact Or.inl ⟨a,n+1,source,trace_last path adj⟩
    · exact Or.inr ⟨a,n+1,source,trace_last path adj⟩
  root := Or.inl (T.input_reaches_root i)

/-- Either selected original input remains an input of the extracted subtree. -/
theorem twoSelection_input (i j k : Fin (List.replicate m s.wire).length)
    (selected : k = i ∨ k = j) :
    ∃ v : (T.twoSelection i j).Vertex,
      v.val = .input k ∧ (T.twoSelection i j).Input v := by
  obtain ⟨e,source⟩ := (T.net.source_coverage (.input k)).mpr (by simp [Port.IsOutput])
  have chosen : (T.twoSelection i j).chosen e := by
    rcases selected with rfl | rfl
    · exact Or.inl ⟨e,0,source,.refl _⟩
    · exact Or.inr ⟨e,0,source,.refl _⟩
  refine ⟨⟨.input k,e,chosen,Or.inl source⟩,rfl,?_⟩
  rintro ⟨f,h⟩
  exact T.net.target_not_input ((Selection.mem_target ..).mp h) trivial

/-- Two input coordinates are retained in order. Every selected edge has a real
 counted ancestry from one of them; all other original branches are excluded. -/
theorem two_input_subtree (d : Nat)
    (i j : Fin (List.replicate m s.wire).length) (ij : i ≠ j) :
    ∃ (h : Nat) (U : ContractionTree s (h+2))
      (f : Occurrence (U.atDepth d) (T.atDepth d)),
      f.ports (.input ⟨0,by simp⟩) = .input i ∧
      f.ports (.input ⟨1,by simp⟩) = .input j ∧
      f.ports (.output 0) = .output 0 ∧
      ∀ e, T.FromInput i (f.edges e) ∨ T.FromInput j (f.edges e) := by
  let S := T.twoSelection i j
  obtain ⟨a,ha,ia⟩ := T.twoSelection_input i j i (Or.inl rfl)
  obtain ⟨b,hb,ib⟩ := T.twoSelection_input i j j (Or.inr rfl)
  have different : a ≠ b := by
    intro eq
    have h := congrArg Subtype.val eq
    rw [ha,hb] at h
    exact ij (Port.input.inj h)
  obtain ⟨rest,nd,boundary⟩ := S.two_input_order a b different ia ib
  let U := S.tree (a::b::rest) nd boundary
  let f := S.occurrence (a::b::rest) nd boundary d
  have result : ∃ (U : ContractionTree s (a::b::rest).length)
      (f : Occurrence (U.atDepth d) (T.atDepth d)),
      f.ports (.input ⟨0,by simp⟩) = .input i ∧
      f.ports (.input ⟨1,by simp⟩) = .input j ∧
      f.ports (.output 0) = .output 0 ∧
      ∀ e, T.FromInput i (f.edges e) ∨ T.FromInput j (f.edges e) := by
    refine ⟨U,f,?_,?_,?_,?_⟩
    · exact ha
    · exact hb
    · rfl
    · intro e; exact e.property
  refine ⟨rest.length,?_⟩
  exact result

end Hypernets.Copying.ContractionTree
