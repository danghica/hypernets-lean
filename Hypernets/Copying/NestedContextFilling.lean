import Hypernets.Copying.BoxContextPlug

/-! Actual filling correspondence for arbitrary nesting of lambdas and unary operations. -/
set_option backward.isDefEq.respectTransparency false
namespace Hypernets.Copying
open Graph

namespace ContextTranslation
/-- Equality of representation depth followed by recursive graph isomorphism.
This relation changes no term, graph, padding choice, or observation class. -/
def ScopedIso {k h} (G H : ScopedGraph k h) : Prop :=
  ∃ eq : G.1 = H.1, Nonempty (DeepIso (Translation.castDepth eq G.2) H.2)

namespace ScopedIso

theorem refl {k h} (G : ScopedGraph k h) : ScopedIso G G := ⟨rfl,⟨DeepIso.refl _⟩⟩

theorem ofIso {d k h} {G H : Hypernet d [.term] (environmentInterface k h)}
    (f : DeepIso G H) : ScopedIso ⟨d,G⟩ ⟨d,H⟩ := ⟨rfl,⟨f⟩⟩

theorem trans {k h} {G H K : ScopedGraph k h} (f : ScopedIso G H) (g : ScopedIso H K) :
    ScopedIso G K := by
  obtain ⟨d,G⟩ := G
  obtain ⟨e,H⟩ := H
  obtain ⟨n,K⟩ := K
  obtain ⟨eq,⟨f⟩⟩ := f
  obtain ⟨eq',⟨g⟩⟩ := g
  change d = e at eq
  change e = n at eq'
  subst e; subst n
  exact ⟨rfl,⟨f.trans g⟩⟩

/-- At equal depths the relation supplies an actual recursive isomorphism. -/
theorem sameDepth {d k h} {G H : Hypernet d [.term] (environmentInterface k h)}
    (f : ScopedIso ⟨d,G⟩ ⟨d,H⟩) : Nonempty (DeepIso G H) := f.2

theorem abstraction {k h} {G H : ScopedGraph (k+1) h} (f : ScopedIso G H) :
    ScopedIso (ContextTranslation.abstraction G) (ContextTranslation.abstraction H) := by
  obtain ⟨d,G⟩ := G
  obtain ⟨e,H⟩ := H
  obtain ⟨eq,⟨f⟩⟩ := f
  change d = e at eq
  subst e
  exact ofIso (Translation.abstraction_congr f)

theorem unary {k h} (o : Unary) {G H : ScopedGraph k h} (f : ScopedIso G H) :
    ScopedIso (ContextTranslation.unary o G) (ContextTranslation.unary o H) := by
  obtain ⟨d,G⟩ := G
  obtain ⟨e,H⟩ := H
  obtain ⟨eq,⟨f⟩⟩ := f
  change d = e at eq
  subst e
  exact ofIso (Translation.unary_congr o f)
end ScopedIso
end ContextTranslation

namespace TermContext
/-- The original contexts generated by holes, lambdas and unary operations.
This is a predicate on the existing grammar, not a replacement term syntax. -/
inductive UnaryLambda {v a} : {k h : Nat} → TermContext v a k h → Prop where
  | hole : UnaryLambda (.hole : TermContext v a v a)
  | lam {k h} {C : TermContext v a (k+1) h} : UnaryLambda C → UnaryLambda (.lam C)
  | unary {k h} (o : Unary) {C : TermContext v a k h} : UnaryLambda C → UnaryLambda (.unary o C)
end TermContext

namespace ContextTranslation
/-- The hole's actual shallow address at any finite allowance. -/
def holeSite (d name v a : Nat) : Site (hole d name v a).2 d [.term] (environmentInterface v a) := by
  cases d <;> exact .shallow _ (0 : Fin 1)

/-- The hole address is the only occurrence in its corolla. -/
theorem holeSite_sole (d name v a : Nat) : SoleHole (holeSite d name v a) := by
  cases d <;> refine ⟨⟨⟨name,[.term],environmentInterface v a⟩,rfl⟩,?_⟩
  all_goals intro e ne; exact False.elim (ne (Fin.ext (by omega)))

/-- Removing the literal hole corolla recovers the supplied graph. -/
noncomputable def hole_filling {d v a} (name : Nat)
    (G : Hypernet d [.term] (environmentInterface v a)) :
    DeepIso (plugAt (holeSite d name v a) G) G := by
  cases d with
  | zero => exact DeepIso.ofIso (Net.corolla_plug_iso (primitiveLabel 0 (.hole ⟨name,[.term],environmentInterface v a⟩)) G)
  | succ d => exact DeepIso.ofIso (Net.corolla_plug_iso (primitiveLabel (d+1) (.hole ⟨name,[.term],environmentInterface v a⟩)) G)

/-- For every lambda/unary context, one actual address works for every fitting
argument graph. Filling is compared with the unchanged constructor interpretation. -/
theorem unaryLambda_filling {v a k h} {C : TermContext v a k h} (allowed : C.UnaryLambda)
    (d name : Nat) : ∃ s : Site (graph C d name).2 d [.term] (environmentInterface v a),
      SoleHole s ∧ ∀ G : Hypernet d [.term] (environmentInterface v a),
        ScopedIso ⟨(graph C d name).1,plugAt s G⟩ (apply C ⟨d,G⟩) := by
  induction allowed with
  | hole => exact ⟨holeSite d name v a,holeSite_sole d name v a,fun G => ScopedIso.ofIso (hole_filling name G)⟩
  | @lam k h C allowed ih =>
    obtain ⟨s,sole,law⟩ := ih
    refine ⟨Translation.abstractionSite s,Translation.abstractionSite_sole s sole,?_⟩
    intro G
    exact (ScopedIso.ofIso (Translation.abstraction_filling s G)).trans
      (ScopedIso.abstraction (law G))
  | @unary k h o C allowed ih =>
    obtain ⟨s,sole,law⟩ := ih
    refine ⟨Translation.unarySite o s,Translation.unarySite_sole o s sole,?_⟩
    intro G
    exact (ScopedIso.ofIso (Translation.unary_filling o s G)).trans
      (ScopedIso.unary o (law G))

/-- Actual plugging reconstructs the original translation of the filled term,
including under arbitrarily many enclosing binders. -/
theorem unaryLambda_term_filling {v a k h} {C : TermContext v a k h}
    (allowed : C.UnaryLambda) (name : Nat) (t : Term v a) :
    ∃ s : Site (graph C (Translation.depth t) name).2 (Translation.depth t)
        [.term] (environmentInterface v a),
      SoleHole s ∧ BindingFree (graph C (Translation.depth t) name).2 ∧
      ScopedIso ⟨(graph C (Translation.depth t) name).1,plugAt s (Translation.term t)⟩
        (ofTerm (C.fill t)) := by
  obtain ⟨s,sole,law⟩ := unaryLambda_filling allowed (Translation.depth t) name
  refine ⟨s,sole,BindingFree.context_graph C _ name,?_⟩
  have result := law (Translation.term t)
  change ScopedIso _ (apply C (ofTerm t)) at result
  rwa [apply_ofTerm] at result
end ContextTranslation
end Hypernets.Copying
