import Hypernets.Graph.PaperEncodingDepth
import Hypernets.Graph.DeepFillings

/-! Depth-independent relations on the finite union of actual-content graphs. -/
namespace Hypernets.Linear.PaperEncoding
open Graph
variable {Op : Type} (ops : Operations Op)

/-- A graph with some finite depth allowance, retaining its ordered outer type. -/
abbrev Bounded (I O : List Wire) := Σ n : Nat, Hypernet ops n I O

/-- Equality in the finite union is generated by recursive renaming and by
padding a depth allowance. No operational transition is an equality generator. -/
inductive GlobalRenaming {I O} : Bounded ops I O → Bounded ops I O → Prop where
  | iso {n} {G H : Hypernet ops n I O} (f : DeepIso ops G H) : GlobalRenaming ⟨n,G⟩ ⟨n,H⟩
  | promote {n} (G : Hypernet ops n I O) : GlobalRenaming ⟨n,G⟩ ⟨n+1,raise ops n G⟩
  | refl (G) : GlobalRenaming G G
  | symm {G H} (h : GlobalRenaming G H) : GlobalRenaming H G
  | trans {G H K} (h : GlobalRenaming G H) (k : GlobalRenaming H K) : GlobalRenaming G K

/-- The finite-union quotient forgets only carrier names and depth padding. -/
def globalSetoid (I O : List Wire) : Setoid (Bounded ops I O) where
  r := GlobalRenaming ops
  iseqv := ⟨GlobalRenaming.refl,GlobalRenaming.symm,GlobalRenaming.trans⟩

abbrev GlobalClass (I O : List Wire) := Quotient (globalSetoid ops I O)

def global {n I O} (G : Hypernet ops n I O) : GlobalClass ops I O :=
  Quotient.mk _ ⟨n,G⟩

/-- Recursive isomorphism does not change a finite-union class. -/
theorem global_iso {n I O} {G H : Hypernet ops n I O} (f : DeepIso ops G H) :
    global ops G = global ops H := Quotient.sound (.iso f)

/-- Increasing the depth allowance does not change the represented graph. -/
theorem global_raise {n I O} (G : Hypernet ops n I O) :
    global ops G = global ops (raise ops n G) := Quotient.sound (.promote G)

/-- Encode a typed graph directly into the depth-independent class. -/
noncomputable def interpret {n I O} (G : Linear.Hypernet ops n I O) : GlobalClass ops I O :=
  global ops (encode ops n 0 0 G)

theorem interpret_iso {n I O} {G H : Linear.Hypernet ops n I O} (f : Linear.DeepIso G H) :
    interpret ops G = interpret ops H := global_iso ops (encode_iso ops n 0 0 0 0 f)

/-- The graph-level commuting square proves interpretation independent of padding. -/
theorem interpret_raise {n I O} (G : Linear.Hypernet ops n I O) :
    interpret ops G = interpret ops (Linear.raise ops n G) := by
  unfold interpret
  rw [encode_raise]
  exact global_raise ops _

/-- Every finite-union graph class has a typed representative at a finite bound. -/
theorem interpret_surjective {I O} (x : GlobalClass ops I O) :
    ∃ n, ∃ G : Linear.Hypernet ops n I O, interpret ops G = x := by
  induction x using Quotient.inductionOn with
  | h x =>
    obtain ⟨n,H⟩ := x
    exact ⟨n,decode ops n H,(global_iso ops (named_roundtrip ops n 0 0 H)).symm⟩

/-- Pull back any relation on the finite union to a fixed-depth typed relation. -/
noncomputable def relation {I O} (R : GlobalClass ops I O → GlobalClass ops I O → Prop)
    (n : Nat) (G H : Linear.Hypernet ops n I O) : Prop :=
  R (interpret ops G) (interpret ops H)

/-- A pulled-back relation is invariant under independent recursive renaming. -/
theorem relation_iso {I O} (R : GlobalClass ops I O → GlobalClass ops I O → Prop)
    {n} {G G' H H' : Linear.Hypernet ops n I O}
    (left : Linear.DeepIso G G') (right : Linear.DeepIso H H') :
    relation ops R n G H ↔ relation ops R n G' H' := by
  unfold relation
  rw [interpret_iso ops left,interpret_iso ops right]

/-- Cross-bound compatibility is proved for relations interpreted from the
finite union; it is not postulated for arbitrary layered pre-templates. -/
theorem relation_raise {I O} (R : GlobalClass ops I O → GlobalClass ops I O → Prop)
    (n : Nat) (G H : Linear.Hypernet ops n I O) :
    relation ops R n G H ↔ relation ops R (n+1) (Linear.raise ops n G) (Linear.raise ops n H) := by
  unfold relation
  rw [← interpret_raise ops G,← interpret_raise ops H]

/-- The same relation-compatibility statement holds for every finite padding. -/
theorem relation_raiseBy {I O} (R : GlobalClass ops I O → GlobalClass ops I O → Prop)
    (n k : Nat) (G H : Linear.Hypernet ops n I O) :
    relation ops R n G H ↔ relation ops R (n+k)
      (SetHierarchy.typedRaiseBy ops n k G) (SetHierarchy.typedRaiseBy ops n k H) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    exact ih.trans (relation_raise ops R (n+k) _ _)
/-- A pre-template on depth-independent graph classes. The focus-freedom
field is the pre-template condition, quantified over typed representatives. -/
structure GlobalPreTemplate where
  Rel : {I O : List Wire} → GlobalClass ops I O → GlobalClass ops I O → Prop
  focus_free : ∀ {n I O} {G H : Linear.Hypernet ops n I O},
    Rel (interpret ops G) (interpret ops H) → FocusFree G ∧ FocusFree H

/-- Interpret a single finite-union pre-template as the existing layered interface. -/
noncomputable def GlobalPreTemplate.toLayered (T : GlobalPreTemplate ops) : LayeredPreTemplate ops :=
  fun n => { Rel := relation ops T.Rel n, focus_free := T.focus_free }

/-- The resulting layered pre-template has the required cross-bound compatibility. -/
theorem GlobalPreTemplate.coherent (T : GlobalPreTemplate ops) {n I O}
    (G H : Linear.Hypernet ops n I O) :
    (T.toLayered ops n).Rel G H ↔ (T.toLayered ops (n+1)).Rel (Linear.raise ops n G) (Linear.raise ops n H) :=
  relation_raise ops T.Rel n G H

/-- Independent recursive renaming also preserves the interpreted pre-template. -/
theorem GlobalPreTemplate.rename (T : GlobalPreTemplate ops) {n I O}
    {G G' H H' : Linear.Hypernet ops n I O} (left : Linear.DeepIso G G') (right : Linear.DeepIso H H') :
    (T.toLayered ops n).Rel G H ↔ (T.toLayered ops n).Rel G' H' :=
  relation_iso ops T.Rel left right
end Hypernets.Linear.PaperEncoding
