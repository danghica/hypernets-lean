import Hypernets.Graph.IndependentSites

/-! Host-and-site pairs modulo structural recursive renaming. -/
namespace Hypernets.Linear
open Graph
variable {Op : Type} {ops : Operations Op}

/-- A typed hypernet with a distinguished addressed occurrence. -/
structure PointedHypernet (ops : Operations Op) (d : Nat) (I O : List Wire)
    (r : Nat) (J K : List Wire) where
  host : Hypernet ops d I O
  site : Site ops host r J K

/-- The equivalence generated by structural site renamings. Only finite
renaming zigzags are identified; equality of plugged results is not a generator. -/
inductive PointedRenaming {d I O r J K} :
    PointedHypernet ops d I O r J K → PointedHypernet ops d I O r J K → Prop where
  | rename {P Q} (iso : SiteIso P.site Q.site) : PointedRenaming P Q
  | refl (P) : PointedRenaming P P
  | symm {P Q} (h : PointedRenaming P Q) : PointedRenaming Q P
  | trans {P Q R} (h : PointedRenaming P Q) (k : PointedRenaming Q R) : PointedRenaming P R

/-- A structural site correspondence includes an isomorphism of its hosts. -/
theorem SiteIso.host {d I O} {G H : Hypernet ops d I O} {r J K}
    {s : Site ops G r J K} {t : Site ops H r J K} (h : SiteIso s t) :
    Nonempty (DeepIso G H) := by
  cases h with
  | shallow f e => exact ⟨f⟩
  | inside f e b label body label' inner => exact ⟨f⟩

theorem PointedRenaming.host {d I O r J K}
    {P Q : PointedHypernet ops d I O r J K} (h : PointedRenaming P Q) :
    Nonempty (DeepIso P.host Q.host) := by
  induction h with
  | rename iso => exact iso.host
  | refl P => exact ⟨DeepIso.refl P.host⟩
  | symm h ih => obtain ⟨f⟩ := ih; exact ⟨f.symm⟩
  | trans h k ih ik => obtain ⟨f⟩ := ih; obtain ⟨g⟩ := ik; exact ⟨f.trans g⟩

/-- A finite renaming zigzag preserves substitution at the distinguished site. -/
theorem PointedRenaming.plug {d I O r J K}
    {P Q : PointedHypernet ops d I O r J K} (h : PointedRenaming P Q)
    (A : Hypernet ops r J K) :
    Nonempty (DeepIso (plugAt P.site A) (plugAt Q.site A)) := by
  induction h with
  | rename iso => exact iso.plug A
  | refl P => exact ⟨DeepIso.refl _⟩
  | symm h ih => obtain ⟨f⟩ := ih; exact ⟨f.symm⟩
  | trans h k ih ik => obtain ⟨f⟩ := ih; obtain ⟨g⟩ := ik; exact ⟨f.trans g⟩

theorem PointedRenaming.plug_congr {d I O r J K}
    {P Q : PointedHypernet ops d I O r J K} (h : PointedRenaming P Q)
    {A B : Hypernet ops r J K} (g : DeepIso A B) :
    Nonempty (DeepIso (plugAt P.site A) (plugAt Q.site B)) := by
  obtain ⟨f⟩ := h.plug A
  exact ⟨f.trans (plugAt_deepIso Q.site g)⟩

/-- Retained-hole inventories descend through the generated equivalence. -/
theorem PointedRenaming.retainedHole_iff {d I O r J K}
    {P Q : PointedHypernet ops d I O r J K} (h : PointedRenaming P Q) (a : Hole) :
    SiteRetainedHole P.site a ↔ SiteRetainedHole Q.site a := by
  induction h with
  | rename iso => exact iso.retainedHole_iff a
  | refl P => rfl
  | symm h ih => exact ih.symm
  | trans h k ih ik => exact ih.trans ik

def pointedSetoid (ops : Operations Op) (d : Nat) (I O : List Wire)
    (r : Nat) (J K : List Wire) : Setoid (PointedHypernet ops d I O r J K) where
  r := PointedRenaming
  iseqv := ⟨PointedRenaming.refl,PointedRenaming.symm,PointedRenaming.trans⟩

/-- A host and its selected occurrence modulo recursive structural renaming. -/
abbrev PointedModuloIso (ops : Operations Op) (d : Nat) (I O : List Wire)
    (r : Nat) (J K : List Wire) := Quotient (pointedSetoid ops d I O r J K)

/-- Substitution is well-defined in both the pointed host and replacement classes. -/
noncomputable def pointedPlug {d I O r J K} :
    PointedModuloIso ops d I O r J K → HypernetModuloIso ops r J K →
      HypernetModuloIso ops d I O :=
  Quotient.lift (fun P => plugAtModuloIso P.site) (by
    intro P Q h
    funext A
    induction A using Quotient.inductionOn with
    | h A => exact Quotient.sound (h.plug A))

theorem pointedPlug_mk {d I O r J K} (P : PointedHypernet ops d I O r J K)
    (A : Hypernet ops r J K) :
    pointedPlug (Quotient.mk _ P) (Quotient.mk _ A) = Quotient.mk _ (plugAt P.site A) := rfl

/-- Forget the distinguished occurrence while retaining the recursive host class. -/
def pointedHost {d I O r J K} :
    PointedModuloIso ops d I O r J K → HypernetModuloIso ops d I O :=
  Quotient.lift (fun P => Quotient.mk _ P.host) (fun _ _ h => Quotient.sound h.host)

/-- The inventory outside the selected occurrence is independent of representatives. -/
def pointedRetainedHole {d I O r J K} (P : PointedModuloIso ops d I O r J K) (a : Hole) : Prop :=
  Quotient.lift (s := pointedSetoid ops d I O r J K) (fun P => SiteRetainedHole P.site a)
    (fun _ _ h => propext (h.retainedHole_iff a)) P

/-- Exact freshness is well-defined on both quotient arguments. -/
def pointedFresh {d I O r J K} :
    PointedModuloIso ops d I O r J K → HypernetModuloIso ops r J K → Prop :=
  Quotient.lift (fun P => Quotient.lift (SiteFresh P.site)
    (by rintro A B ⟨f⟩; exact propext (siteFresh_deepIso_iff P.site f))) (by
    intro P Q h
    funext A
    induction A using Quotient.inductionOn with
    | h A =>
      apply propext
      exact ⟨fun fresh a retained present => fresh a ((h.retainedHole_iff a).mpr retained) present,
        fun fresh a retained present => fresh a ((h.retainedHole_iff a).mp retained) present⟩)

/-- The sharp context criterion now holds without selecting carrier names. -/
theorem pointedPlug_unique_iff {d I O r J K}
    (P : PointedModuloIso ops d I O r J K) (A : HypernetModuloIso ops r J K)
    (hostUnique : moduloIsoUniqueHoles (pointedHost P)) :
    moduloIsoUniqueHoles (pointedPlug P A) ↔ moduloIsoUniqueHoles A ∧ pointedFresh P A := by
  induction P using Quotient.inductionOn with
  | h P =>
    induction A using Quotient.inductionOn with
    | h A => exact plugAt_uniqueHoles_iff P.site A hostUnique

/-- Transporting an occurrence along any recursive host isomorphism leaves its class unchanged. -/
theorem pointed_transport {d I O r J K} {C D : Hypernet ops d I O}
    (s : Site ops C r J K) (f : DeepIso C D) :
    Quotient.mk (pointedSetoid ops d I O r J K) ⟨C,s⟩ =
      Quotient.mk (pointedSetoid ops d I O r J K) ⟨D,s.transport f⟩ :=
  Quotient.sound (.rename (s.transport_spec f))

/-- The concrete deep interchange law is an equality using the fully quotiented operation. -/
theorem IndependentSites.pointed_interchange {d I O} {C : Hypernet ops d I O}
    {r J K q U V} {s : Site ops C r J K} {t : Site ops C q U V}
    (h : IndependentSites s t) (A : Hypernet ops r J K) (B : Hypernet ops q U V) :
    pointedPlug (Quotient.mk _ ⟨plugAt s A,(h.interchange A B).rightAfterLeft⟩) (Quotient.mk _ B) =
      pointedPlug (Quotient.mk _ ⟨plugAt t B,(h.interchange A B).leftAfterRight⟩) (Quotient.mk _ A) :=
  Quotient.sound ⟨(h.interchange A B).iso⟩

end Hypernets.Linear
